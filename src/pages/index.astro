---
// Import the React component
import BarcodeScanner from '../components/BarcodeScanner.jsx';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Smart Space Barcode Scanner">
  <main style={{ padding: '2rem', fontFamily: 'sans-serif', textAlign: 'center' }}>
    <h1>Live Barcode Scanner</h1>
    <p>Point your device camera at a barcode to capture readiing.</p>
    
    <!-- client:only ensures it runs exclusively in the browser -->
    <BarcodeScanner client:only="react" />
  </main>
</Layout>